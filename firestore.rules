rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function validText(t) { return t is string && t.size() >= 1 && t.size() <= 500 && t.matches('[\\s\\S]*[^\\s][\\s\\S]*'); }
  match /users/{uid} {
   allow read: if signedIn() && request.auth.uid == uid;
   allow create: if signedIn() && request.auth.uid == uid
    && request.resource.data.keys().hasAll(['uid','firstName','lastName','role','registrationDateTime'])
    && request.resource.data.keys().hasOnly(['uid','firstName','lastName','role','registrationDateTime'])
    && request.resource.data.uid == uid
    && request.resource.data.firstName is string && request.resource.data.firstName.size() > 0 && request.resource.data.firstName.size() <= 40
    && request.resource.data.lastName is string && request.resource.data.lastName.size() > 0 && request.resource.data.lastName.size() <= 40
    && request.resource.data.role == 'student'
    && request.resource.data.registrationDateTime == request.time;
   allow update, delete: if false;
  }
  match /messages/{id} {
   allow read: if signedIn();
   allow create: if signedIn()
    && request.resource.data.keys().hasAll(['text','authorUid','authorName','createdAt','editedAt'])
    && request.resource.data.keys().hasOnly(['text','authorUid','authorName','createdAt','editedAt'])
    && validText(request.resource.data.text)
    && request.resource.data.authorUid == request.auth.uid
    && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.firstName
    && request.resource.data.createdAt == request.time && request.resource.data.editedAt == null;
   allow update: if signedIn() && resource.data.authorUid == request.auth.uid
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt'])
    && validText(request.resource.data.text) && request.resource.data.editedAt == request.time;
   allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
